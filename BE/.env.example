PORT=3000

# ===== Supabase (Project Settings -> API) =====
# Thay bang thong tin cua project Supabase MOI cua ban
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===== Firebase push notification (tuy chon) =====
# Neu khong co file key, server van chay binh thuong, chi tat push notification.
# Vi du: GOOGLE_APPLICATION_CREDENTIALS=keys/firebase-adminsdk.json
GOOGLE_APPLICATION_CREDENTIALS=
